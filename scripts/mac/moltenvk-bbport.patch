+++ b/MoltenVK/MoltenVK/Commands/MVKCmdBBMetalFX.h
@@ -0,0 +1,56 @@
+/*
+ * MVKCmdBBMetalFX.h
+ *
+ * bbport: vkCmdUpscaleMetalFXBB, a command of this MoltenVK build (not a Vulkan extension) that
+ * runs Apple's MetalFX temporal scaler at its place in the command stream: render-size color,
+ * depth and motion vectors in, output-size color out. bbport (gpu/upscale) looks it up with
+ * vkGetDeviceProcAddr and uses it as an upscaler where it exists.
+ */
+
+#pragma once
+
+#include "MVKCommand.h"
+#include <vulkan/vulkan.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct VkBBMetalFXUpscaleInfo {
+	VkImage color;           ///< Render-size scene color (RGBA16F)
+	VkImage depth;           ///< Render-size depth
+	VkImage motion;          ///< Render-size motion vectors (RG16F), current to previous
+	VkImage output;          ///< Output-size color
+	uint32_t inputWidth;
+	uint32_t inputHeight;
+	uint32_t outputWidth;
+	uint32_t outputHeight;
+	float jitterX;           ///< Sub-pixel jitter of this frame, in input pixels
+	float jitterY;
+	float motionScaleX;      ///< Scale that takes the motion texture's values to input pixels
+	float motionScaleY;
+	VkBool32 reset;          ///< The history is invalid (camera cut, resize)
+	VkBool32 depthReversed;  ///< Far is 0
+	VkBool32 hdr;            ///< Linear HDR color (auto exposure); else display-ready color
+} VkBBMetalFXUpscaleInfo;
+
+typedef void (VKAPI_PTR *PFN_vkCmdUpscaleMetalFXBB)(VkCommandBuffer commandBuffer, const VkBBMetalFXUpscaleInfo* pInfo);
+
+void VKAPI_CALL vkCmdUpscaleMetalFXBB(VkCommandBuffer commandBuffer, const VkBBMetalFXUpscaleInfo* pInfo);
+
+#ifdef __cplusplus
+}
+#endif
+
+class MVKCmdBBMetalFXUpscale : public MVKCommand {
+
+public:
+	VkResult setContent(MVKCommandBuffer* cmdBuff, const VkBBMetalFXUpscaleInfo* pInfo);
+
+	void encode(MVKCommandEncoder* cmdEncoder) override;
+
+protected:
+	MVKCommandTypePool<MVKCommand>* getTypePool(MVKCommandPool* cmdPool) override;
+
+	VkBBMetalFXUpscaleInfo _info;
+};
diff --git a/MoltenVK/MoltenVK/Commands/MVKCmdBBMetalFX.mm b/MoltenVK/MoltenVK/Commands/MVKCmdBBMetalFX.mm
new file mode 100644
index 0000000..99a2e79
--- /dev/null
+++ b/MoltenVK/MoltenVK/Commands/MVKCmdBBMetalFX.mm
@@ -0,0 +1,154 @@
+/*
+ * MVKCmdBBMetalFX.mm
+ *
+ * bbport: vkCmdUpscaleMetalFXBB (MVKCmdBBMetalFX.h).
+ */
+
+#include "MVKCmdBBMetalFX.h"
+#include "MVKCommandBuffer.h"
+#include "MVKCommandPool.h"
+#include "MVKImage.h"
+#include "MVKBBPassStats.h"
+#import <MetalFX/MetalFX.h>
+#include <map>
+#include <mutex>
+#include <tuple>
+
+namespace {
+
+/// A temporal scaler per (formats, sizes), kept for the process; with the textures it needs in
+/// place of ours when ours lack a usage MetalFX asks for (filled by blits before and after).
+struct BBScaler {
+	id<MTLFXTemporalScaler> scaler = nil;
+	id<MTLTexture> color = nil, depth = nil, motion = nil, output = nil;
+};
+
+id<MTLTexture> bbStandIn(id<MTLDevice> device, id<MTLTexture> like, MTLTextureUsage usage, uint32_t width, uint32_t height) {
+	MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat: like.pixelFormat
+																					width: width
+																				   height: height
+																				mipmapped: NO];
+	desc.usage = usage;
+	desc.storageMode = MTLStorageModePrivate;
+	return [device newTextureWithDescriptor: desc];
+}
+
+BBScaler* bbGetScaler(id<MTLDevice> device, id<MTLTexture> color, id<MTLTexture> depth, id<MTLTexture> motion,
+					  id<MTLTexture> output, const VkBBMetalFXUpscaleInfo& info) {
+	using Key = std::tuple<NSUInteger, NSUInteger, NSUInteger, NSUInteger, uint32_t, uint32_t, uint32_t, uint32_t, bool, bool>;
+	static std::mutex lock;
+	static std::map<Key, BBScaler> scalers;
+	const Key key{color.pixelFormat, depth.pixelFormat, motion.pixelFormat, output.pixelFormat,
+				  info.inputWidth, info.inputHeight, info.outputWidth, info.outputHeight, bool(info.depthReversed), bool(info.hdr)};
+	std::scoped_lock guard{lock};
+	auto [it, added] = scalers.try_emplace(key);
+	BBScaler& entry = it->second;
+	if ( !added ) { return entry.scaler ? &entry : nullptr; }
+	if ( ![MTLFXTemporalScalerDescriptor supportsDevice: device] ) {
+		fprintf(stderr, "[mvk-bb] MetalFX: the temporal scaler is not supported on this device\n");
+		return nullptr;
+	}
+	MTLFXTemporalScalerDescriptor* desc = [MTLFXTemporalScalerDescriptor new];
+	desc.colorTextureFormat = color.pixelFormat;
+	desc.depthTextureFormat = depth.pixelFormat;
+	desc.motionTextureFormat = motion.pixelFormat;
+	desc.outputTextureFormat = output.pixelFormat;
+	desc.inputWidth = info.inputWidth;
+	desc.inputHeight = info.inputHeight;
+	desc.outputWidth = info.outputWidth;
+	desc.outputHeight = info.outputHeight;
+	desc.autoExposureEnabled = info.hdr ? YES : NO;
+	entry.scaler = [desc newTemporalScalerWithDevice: device];
+	[desc release];
+	if ( !entry.scaler ) {
+		fprintf(stderr, "[mvk-bb] MetalFX: no temporal scaler for color %lu, depth %lu, motion %lu, output %lu, %ux%u to %ux%u\n",
+				(unsigned long)color.pixelFormat, (unsigned long)depth.pixelFormat, (unsigned long)motion.pixelFormat,
+				(unsigned long)output.pixelFormat, info.inputWidth, info.inputHeight, info.outputWidth, info.outputHeight);
+		return nullptr;
+	}
+	entry.scaler.depthReversed = info.depthReversed;
+	const auto needs = [](id<MTLTexture> texture, MTLTextureUsage usage) { return (texture.usage & usage) != usage; };
+	if (needs(color, entry.scaler.colorTextureUsage)) { entry.color = bbStandIn(device, color, entry.scaler.colorTextureUsage, info.inputWidth, info.inputHeight); }
+	if (needs(depth, entry.scaler.depthTextureUsage)) { entry.depth = bbStandIn(device, depth, entry.scaler.depthTextureUsage, info.inputWidth, info.inputHeight); }
+	if (needs(motion, entry.scaler.motionTextureUsage)) { entry.motion = bbStandIn(device, motion, entry.scaler.motionTextureUsage, info.inputWidth, info.inputHeight); }
+	if (needs(output, entry.scaler.outputTextureUsage)) { entry.output = bbStandIn(device, output, entry.scaler.outputTextureUsage, info.outputWidth, info.outputHeight); }
+	fprintf(stderr, "[mvk-bb] MetalFX: temporal scaler %ux%u to %ux%u (stand-ins: color %d, depth %d, motion %d, output %d)\n",
+			info.inputWidth, info.inputHeight, info.outputWidth, info.outputHeight,
+			entry.color != nil, entry.depth != nil, entry.motion != nil, entry.output != nil);
+	return &entry;
+}
+
+void bbBlit(id<MTLCommandBuffer> cmdBuffer, id<MTLTexture> from, id<MTLTexture> to, uint32_t width, uint32_t height) {
+	id<MTLBlitCommandEncoder> blit = [cmdBuffer blitCommandEncoder];
+	[blit copyFromTexture: from sourceSlice: 0 sourceLevel: 0 sourceOrigin: MTLOriginMake(0, 0, 0)
+			   sourceSize: MTLSizeMake(width, height, 1)
+				toTexture: to destinationSlice: 0 destinationLevel: 0 destinationOrigin: MTLOriginMake(0, 0, 0)];
+	[blit endEncoding];
+}
+
+}
+
+VkResult MVKCmdBBMetalFXUpscale::setContent(MVKCommandBuffer* cmdBuff, const VkBBMetalFXUpscaleInfo* pInfo) {
+	_info = *pInfo;
+	return VK_SUCCESS;
+}
+
+void MVKCmdBBMetalFXUpscale::encode(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->endCurrentMetalEncoding();
+	id<MTLTexture> color = ((MVKImage*)_info.color)->getMTLTexture();
+	id<MTLTexture> depth = ((MVKImage*)_info.depth)->getMTLTexture();
+	id<MTLTexture> motion = ((MVKImage*)_info.motion)->getMTLTexture();
+	id<MTLTexture> output = ((MVKImage*)_info.output)->getMTLTexture();
+	BBScaler* fx = bbGetScaler(cmdEncoder->getMTLDevice(), color, depth, motion, output, _info);
+	if ( !fx ) { return; }
+	id<MTLCommandBuffer> cmdBuffer = cmdEncoder->_mtlCmdBuffer;
+	const uint32_t iw = _info.inputWidth, ih = _info.inputHeight;
+	id<MTLFXTemporalScaler> scaler = fx->scaler;
+	if (cmdEncoder->bbFencesOn()) {
+		// Untracked resources (MVK_BB_UNTRACKED): after everything before, by the stage fences;
+		// the scaler waits for and updates a fence of its own.
+		static id<MTLFence> fence = [cmdEncoder->getMTLDevice() newFence];
+		id<MTLBlitCommandEncoder> blit = [cmdBuffer blitCommandEncoder];
+		for (int stage = 0; stage < kMVKBarrierStageCount; stage++) { [blit waitForFence: cmdEncoder->bbStageFenceToWait(stage)]; }
+		const auto copy = [&](id<MTLTexture> from, id<MTLTexture> to) {
+			[blit copyFromTexture: from sourceSlice: 0 sourceLevel: 0 sourceOrigin: MTLOriginMake(0, 0, 0)
+					   sourceSize: MTLSizeMake(iw, ih, 1)
+						toTexture: to destinationSlice: 0 destinationLevel: 0 destinationOrigin: MTLOriginMake(0, 0, 0)];
+		};
+		if (fx->color) { copy(color, fx->color); color = fx->color; }
+		if (fx->depth) { copy(depth, fx->depth); depth = fx->depth; }
+		if (fx->motion) { copy(motion, fx->motion); motion = fx->motion; }
+		[blit updateFence: fence];
+		[blit endEncoding];
+		scaler.fence = fence;
+	} else {
+		if (fx->color) { bbBlit(cmdBuffer, color, fx->color, iw, ih); color = fx->color; }
+		if (fx->depth) { bbBlit(cmdBuffer, depth, fx->depth, iw, ih); depth = fx->depth; }
+		if (fx->motion) { bbBlit(cmdBuffer, motion, fx->motion, iw, ih); motion = fx->motion; }
+	}
+	scaler.colorTexture = color;
+	scaler.depthTexture = depth;
+	scaler.motionTexture = motion;
+	scaler.outputTexture = fx->output ? fx->output : output;
+	scaler.inputContentWidth = iw;
+	scaler.inputContentHeight = ih;
+	scaler.jitterOffsetX = _info.jitterX;
+	scaler.jitterOffsetY = _info.jitterY;
+	scaler.motionVectorScaleX = _info.motionScaleX;
+	scaler.motionVectorScaleY = _info.motionScaleY;
+	scaler.reset = _info.reset;
+	[scaler encodeToCommandBuffer: cmdBuffer];
+	if (cmdEncoder->bbFencesOn()) {
+		id<MTLBlitCommandEncoder> blit = [cmdBuffer blitCommandEncoder];
+		[blit waitForFence: scaler.fence];
+		if (fx->output) {
+			[blit copyFromTexture: fx->output sourceSlice: 0 sourceLevel: 0 sourceOrigin: MTLOriginMake(0, 0, 0)
+					   sourceSize: MTLSizeMake(_info.outputWidth, _info.outputHeight, 1)
+						toTexture: output destinationSlice: 0 destinationLevel: 0 destinationOrigin: MTLOriginMake(0, 0, 0)];
+		}
+		for (int stage = 0; stage < kMVKBarrierStageCount; stage++) { [blit updateFence: cmdEncoder->bbStageFence(stage)]; }
+		[blit endEncoding];
+	} else if (fx->output) {
+		bbBlit(cmdBuffer, fx->output, output, _info.outputWidth, _info.outputHeight);
+	}
+}
