diff --git a/MoltenVK/MoltenVK/Commands/MVKBBPassStats.h b/MoltenVK/MoltenVK/Commands/MVKBBPassStats.h
new file mode 100644
index 0000000..2759a48
--- /dev/null
+++ b/MoltenVK/MoltenVK/Commands/MVKBBPassStats.h
@@ -0,0 +1,155 @@
+/*
+ * MVKBBPassStats.h
+ *
+ * bbport: statistics of the Metal encoders made from each frame's Vulkan commands
+ * (MVK_BB_PASS_STATS=1): render passes, the command that ended each one, compute and blit
+ * encoders, and render passes that reopen the attachments of the one before them with only
+ * other work between (what a pass planner could merge). Printed every 5 s per presented frame.
+ */
+
+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cxxabi.h>
+#include <map>
+#include <mutex>
+#include <string>
+#include <typeinfo>
+#include <unordered_map>
+
+namespace mvkbb {
+
+/**
+ * MVK_BB_UNTRACKED=1 (experiment): buffers, textures and heaps without Metal's hazard tracking,
+ * ordered by the per-stage barrier fences instead (as with argument buffers and residency sets).
+ * Tracking is per resource: one big buffer of the game's memory serialized everything touching it.
+ */
+inline bool untracked() {
+	static const bool enabled = [] {
+		const char* env = std::getenv("MVK_BB_UNTRACKED");
+		return env && env[0] == '1';
+	}();
+	return enabled;
+}
+
+inline bool passStatsEnabled() {
+	static const bool enabled = [] {
+		const char* env = std::getenv("MVK_BB_PASS_STATS");
+		return env && env[0] == '1';
+	}();
+	return enabled;
+}
+
+/** A command's class name without namespaces or template arguments ("MVKCmdDispatch"). */
+inline const char* commandName(const std::type_info& type) {
+	static std::mutex lock;
+	static std::unordered_map<const std::type_info*, std::string> names;
+	std::scoped_lock guard{lock};
+	auto [it, added] = names.try_emplace(&type);
+	if (added) {
+		int status = 0;
+		char* full = abi::__cxa_demangle(type.name(), nullptr, nullptr, &status);
+		std::string name = status == 0 && full ? full : type.name();
+		std::free(full);
+		if (auto lt = name.find('<'); lt != std::string::npos) { name.resize(lt); }
+		if (auto colon = name.rfind("::"); colon != std::string::npos) { name.erase(0, colon + 2); }
+		it->second = name;
+	}
+	return it->second.c_str();
+}
+
+class PassStats {
+public:
+	static PassStats& get() {
+		static PassStats stats;
+		return stats;
+	}
+
+	void renderPass(bool restart, const char* reason) {
+		std::scoped_lock guard{_lock};
+		_renderPasses++;
+		if (restart) { _restarts[reason]++; }
+	}
+	void renderEnd(const char* reason) {
+		std::scoped_lock guard{_lock};
+		_ends[reason]++;
+	}
+	void computeEncoder(const char* reason) {
+		std::scoped_lock guard{_lock};
+		_computeEncoders++;
+		_computeReasons[reason]++;
+	}
+	void blitEncoder(const char* reason) {
+		std::scoped_lock guard{_lock};
+		_blitEncoders++;
+		_blitReasons[reason]++;
+	}
+	void planned(uint32_t tessDraws, uint32_t merged, uint32_t groups) {
+		std::scoped_lock guard{_lock};
+		_hoistedPasses++;
+		_hoistedDraws += tessDraws;
+		_merged += merged;
+		_groups += groups;
+	}
+	void reopen(bool sameAttachments, const std::string& between) {
+		std::scoped_lock guard{_lock};
+		if (sameAttachments) {
+			_reopenSame++;
+			_between[between]++;
+		} else {
+			_reopenOther++;
+		}
+	}
+	void present() {
+		std::scoped_lock guard{_lock};
+		_frames++;
+		const auto now = std::chrono::steady_clock::now();
+		if (_since.time_since_epoch().count() == 0) { _since = now; }
+		if (now - _since < std::chrono::seconds{5}) { return; }
+		const double frames = _frames ? double(_frames) : 1.0;
+		std::fprintf(stderr, "[mvk-bb] %.0f frames in %.1f s: per frame %.1f render passes, %.1f compute and %.1f blit encoders; "
+				"%.1f passes reopen the previous one's attachments, %.1f open others; tessellation hoisted for %.1f draws, %.1f passes merged with %.1f groups ahead (%.1f planned)\n",
+				frames, std::chrono::duration<double>(now - _since).count(),
+				_renderPasses / frames, _computeEncoders / frames, _blitEncoders / frames,
+				_reopenSame / frames, _reopenOther / frames, _hoistedDraws / frames, _merged / frames, _groups / frames, _hoistedPasses / frames);
+		print("  render pass ended by", _ends, frames);
+		print("  render pass restarted by", _restarts, frames);
+		print("  compute encoder for", _computeReasons, frames);
+		print("  blit encoder for", _blitReasons, frames);
+		print("  between a pass and its reopening", _between, frames);
+		reset();
+		_since = now;
+	}
+
+private:
+	using Counts = std::map<std::string, uint64_t>;
+
+	static void print(const char* title, const Counts& counts, double frames) {
+		if (counts.empty()) { return; }
+		std::multimap<uint64_t, const std::string*, std::greater<>> ranked;
+		for (const auto& [name, count] : counts) { ranked.emplace(count, &name); }
+		std::fprintf(stderr, "%s:", title);
+		int shown = 0;
+		for (const auto& [count, name] : ranked) {
+			if (shown++ == 8) { break; }
+			std::fprintf(stderr, " %s %.1f;", name->c_str(), count / frames);
+		}
+		std::fprintf(stderr, "\n");
+	}
+
+	void reset() {
+		_frames = _renderPasses = _computeEncoders = _blitEncoders = _reopenSame = _reopenOther = 0;
+		_hoistedPasses = _hoistedDraws = _merged = _groups = 0;
+		_ends.clear(); _restarts.clear(); _computeReasons.clear(); _blitReasons.clear(); _between.clear();
+	}
+
+	std::mutex _lock;
+	std::chrono::steady_clock::time_point _since{};
+	uint64_t _frames = 0, _renderPasses = 0, _computeEncoders = 0, _blitEncoders = 0;
+	uint64_t _reopenSame = 0, _reopenOther = 0, _hoistedPasses = 0, _hoistedDraws = 0, _merged = 0, _groups = 0;
+	Counts _ends, _restarts, _computeReasons, _blitReasons, _between;
+};
+
+}
diff --git a/MoltenVK/MoltenVK/Commands/MVKCmdBBMetalFX.h b/MoltenVK/MoltenVK/Commands/MVKCmdBBMetalFX.h
new file mode 100644
index 0000000..6d5f372
