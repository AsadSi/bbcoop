+static bool bbContinues(const VkRenderingInfo& prev, const VkRenderingInfo& next) {
+	const auto same = [](const VkRenderingAttachmentInfo* a, const VkRenderingAttachmentInfo* b) {
+		if ( !a || !b ) { return a == b; }
