+				// draw follows a tessellated one: hoisted there, the game's mist dropped out for a frame
+				// in 2-6% of frames (bbcoop, out/flicker-harness/fogab.sh), cause not found.
+				tessBlocked |= (pipeline && pipeline->isTessellationPipeline()) || tessellated;
