+			}
+		}
+		if ( !end ) { return; }	// The rendering goes on in another command buffer.
+		runEnd = end;
+		if ( !merge || queries ) { break; }
+
+		// What follows: state commands and labelled groups, then the same rendering again?
+		std::vector<std::pair<MVKCommand*, MVKCommand*>> gapGroups;
+		MVKCommand* next = end->_next;
+		while (next && !next->bbRenderingInfo()) {
+			if (next->bbIsLabelBegin("bb-hoist")) {
+				MVKCommand* last = next->_next;
+				int depth = 1;
+				for ( ; last; last = last->_next) {
+					if (last->bbIsLabelBegin("")) { depth++; }	// nested labels of any name
+					if (bbNamed(last, "MVKCmdDebugMarkerBegin")) { depth++; }
+					if (bbNamed(last, "MVKCmdDebugMarkerEnd") && --depth == 0) { break; }
+				}
+				if ( !last ) { break; }
+				gapGroups.emplace_back(next, last);
+				next = last->_next;
+			} else if (bbIsStateCommand(next)) {
+				next = next->_next;
+			} else {
+				break;
+			}
+		}
+		const VkRenderingInfo* nextInfo = next ? next->bbRenderingInfo() : nullptr;
+		if ( !nextInfo || !bbContinues(*piece->bbRenderingInfo(), *nextInfo) ) { break; }
+		_bbSkip.insert(end);
+		_bbSkip.insert(next);
+		for (auto& [first, last] : gapGroups) {
+			for (MVKCommand* cmd = first; ; cmd = cmd->_next) {
+				_bbSkip.insert(cmd);
+				if (cmd == last) { break; }
+			}
